---
import type { Dict } from "../i18n/en";

interface Props {
  dict: Dict["footer"];
}

const { dict } = Astro.props;
---

<footer class="border-t border-hairline">
  <div
    class="mx-auto max-w-3xl px-6 py-14 text-center font-serif text-ink-soft sm:px-8"
  >
    <p class="text-base text-ink">
      {dict.madeBy} <span class="font-semibold">Miroslav Macura</span> {dict.madeBySuffix}
    </p>

    <a
      href="https://www.linkedin.com/in/miroslav-macura/"
      class="mt-3 inline-flex items-center gap-1.5 font-sans text-sm text-ribbon underline decoration-ribbon/40 underline-offset-4 transition hover:decoration-ribbon"
      target="_blank"
      rel="noopener noreferrer"
    >
      {dict.linkedin}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="14"
        height="14"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M7 17 17 7" /><path d="M7 7h10v10" />
      </svg>
    </a>

    <div class="mt-8 h-px w-16 mx-auto bg-hairline" aria-hidden="true"></div>

    <p class="mt-8 text-sm italic leading-relaxed">
      {dict.pwaNote}
    </p>
    <a
      href={dict.installHref}
      class="mt-3 inline-flex items-center gap-1.5 font-sans text-sm text-ribbon underline decoration-ribbon/40 underline-offset-4 transition hover:decoration-ribbon"
    >
      {dict.installGuideLabel}
    </a>
  </div>
</footer>
