---
interface Props {
  id: string;
  name: string;
  benefit: string;
  href: string;
  tags: string[];
  icon: string;
  benefits?: string[];
  visitLabel: string;
  whatsInsideLabel: string;
  demoLabel: string;
}

const {
  id,
  name,
  benefit,
  href,
  tags,
  icon,
  benefits,
  visitLabel,
  whatsInsideLabel,
  demoLabel,
} = Astro.props;
---

<article
  id={id}
  class="flex scroll-mt-6 flex-col gap-6 rounded-2xl border border-hairline bg-card p-6 shadow-[0_1px_0_var(--color-hairline)] sm:p-8"
>
  <header class="flex items-start gap-4">
    <div
      class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-ribbon/10 p-2"
    >
      <img src={icon} alt="" class="h-full w-full object-contain" />
    </div>
    <div>
      <h3 class="text-2xl text-ink">{name}</h3>
      <p class="mt-1 text-ink-soft">{benefit}</p>
    </div>
  </header>

  <div
    class="relative cursor-pointer overflow-hidden rounded-xl border border-hairline bg-paper/60 p-4 transition-all duration-200 hover:-translate-y-0.5 hover:border-ribbon/40 hover:shadow-[0_6px_16px_rgba(43,36,29,0.1)] motion-reduce:transition-none motion-reduce:hover:translate-y-0 sm:p-5"
  >
    <span
      class="pointer-events-none absolute -right-9 top-3 w-32 rotate-45 bg-ribbon py-0.5 text-center text-[10px] font-semibold uppercase tracking-wider text-paper shadow-[0_1px_2px_rgba(43,36,29,0.25)]"
      aria-hidden="true"
    >
      {demoLabel}
    </span>
    <slot />
  </div>

  <footer class="flex flex-wrap items-center justify-between gap-4">
    <ul class="flex flex-wrap gap-2">
      {
        tags.map((tag) => (
          <li class="rounded-full border border-hairline px-3 py-1 text-xs text-ink-soft">
            {tag}
          </li>
        ))
      }
    </ul>
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 text-sm font-medium text-ribbon underline decoration-ribbon/40 underline-offset-4 transition hover:decoration-ribbon"
    >
      {visitLabel}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="13"
        height="13"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M7 17 17 7" /><path d="M7 7h10v10" />
      </svg>
    </a>
  </footer>

  {
    benefits && benefits.length > 0 && (
      <details class="group border-t border-hairline pt-4 [&_summary::-webkit-details-marker]:hidden">
        <summary class="flex w-fit cursor-pointer list-none items-center gap-2 rounded-full border border-hairline bg-paper/60 px-4 py-2 text-sm font-medium text-ink-soft transition hover:border-ribbon/40 hover:text-ribbon">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="14"
            height="14"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 6h16M4 12h16M4 18h10" />
          </svg>
          {whatsInsideLabel}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="12"
            height="12"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="transition-transform duration-150 group-open:rotate-180"
          >
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {benefits.map((item) => (
            <li class="flex items-start gap-2.5 rounded-lg bg-paper/60 p-3">
              <span
                class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-ribbon/15 text-ribbon"
                aria-hidden="true"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  width="12"
                  height="12"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12l5 5L20 7" />
                </svg>
              </span>
              <span class="text-sm text-ink-soft">{item}</span>
            </li>
          ))}
        </ul>
      </details>
    )
  }
</article>
