---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import LukumakuDemo from "../components/LukumakuDemo.svelte";
import MuistiDemo from "../components/MuistiDemo.svelte";
import FiilisDemo from "../components/FiilisDemo.svelte";
import { en as dict } from "../i18n/en";
---

<Layout>
  <main class="mx-auto max-w-3xl px-6 sm:px-8">
    <section class="flex min-h-[70vh] flex-col justify-center py-24">
      <p class="font-serif text-sm uppercase tracking-[0.2em] text-ribbon">
        {dict.hero.eyebrow}
      </p>
      <h1 class="mt-4 max-w-xl text-4xl leading-tight text-ink sm:text-5xl">
        {dict.hero.title}
      </h1>
      <p class="mt-6 max-w-md text-lg text-ink-soft">
        {dict.hero.subtitle}
      </p>

      <div class="mt-8 flex items-center gap-3">
        <a
          href="#lukumaku"
          aria-label={dict.hero.jumpTo("Lukumaku")}
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-hairline bg-card p-2 transition hover:-translate-y-0.5 hover:border-ribbon/40"
        >
          <img src="/icons/lukumaku.png" alt="" class="h-full w-full object-contain" />
        </a>
        <a
          href="#muisti"
          aria-label={dict.hero.jumpTo("Muisti")}
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-hairline bg-card p-2 transition hover:-translate-y-0.5 hover:border-ribbon/40"
        >
          <img src="/icons/muisti.svg" alt="" class="h-full w-full object-contain" />
        </a>
        <a
          href="#fiilis"
          aria-label={dict.hero.jumpTo("Fiilis")}
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-hairline bg-card p-2 transition hover:-translate-y-0.5 hover:border-ribbon/40"
        >
          <img src="/icons/fiilis.svg" alt="" class="h-full w-full object-contain" />
        </a>
        <span class="ml-1 font-serif text-sm text-ink-soft/70">{dict.hero.moreToCome}</span>
      </div>
    </section>

    <section class="flex flex-col gap-8 pb-28">
      <ProjectCard
        id="lukumaku"
        name="Lukumaku"
        benefit={dict.projects.lukumaku.benefit}
        href="https://luku.netlify.app/"
        tags={dict.projects.lukumaku.tags}
        icon="/icons/lukumaku.png"
        benefits={dict.projects.lukumaku.benefits}
        visitLabel={dict.card.visit("Lukumaku")}
        whatsInsideLabel={dict.card.whatsInside}
        demoLabel={dict.card.demo}
      >
        <LukumakuDemo client:visible lang="en" />
      </ProjectCard>

      <ProjectCard
        id="muisti"
        name="Muisti"
        benefit={dict.projects.muisti.benefit}
        href="https://muista.netlify.app/"
        tags={dict.projects.muisti.tags}
        icon="/icons/muisti.svg"
        benefits={dict.projects.muisti.benefits}
        visitLabel={dict.card.visit("Muisti")}
        whatsInsideLabel={dict.card.whatsInside}
        demoLabel={dict.card.demo}
      >
        <MuistiDemo client:visible lang="en" />
      </ProjectCard>

      <ProjectCard
        id="fiilis"
        name="Fiilis"
        benefit={dict.projects.fiilis.benefit}
        href="https://fiilis.netlify.app/"
        tags={dict.projects.fiilis.tags}
        icon="/icons/fiilis.svg"
        benefits={dict.projects.fiilis.benefits}
        visitLabel={dict.card.visit("Fiilis")}
        whatsInsideLabel={dict.card.whatsInside}
        demoLabel={dict.card.demo}
      >
        <FiilisDemo client:visible lang="en" />
      </ProjectCard>
    </section>
  </main>
</Layout>
